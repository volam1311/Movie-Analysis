# Copy to .env and fill in the values:  cp .env.example .env
# Never commit .env. For GitHub Actions, add each variable as a repository secret instead.
#
# Keep comments on their own lines and don't quote values:
# `docker run --env-file .env` reads each line literally.

# TMDB API read access token, sent as "Authorization: Bearer <token>".
# https://www.themoviedb.org/settings/api
READACCESS_TOKEN=

# Optional: older-style TMDB API key. The pipeline does not use it.
# TMDB_API_KEY=

# Databricks SQL warehouse: copy these from the warehouse's "Connection details" tab.
# Hostname without https://, e.g. dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_SERVER_HOSTNAME=
# e.g. /sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_HTTP_PATH=
# Personal access token (User settings > Developer > Access tokens)
DATABRICKS_TOKEN=
# A catalog you can write to
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=gold

# Optional: DuckDB file used by dbt. Defaults to data/warehouse.duckdb in the project root.
# DUCKDB_PATH=
